<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>OllamaToolkit.App</AssemblyName>
    <ApplicationIcon>Assets\ollama_gui_manager_icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <Target Name="SetSourceRevisionId" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo"
          Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true"
          WorkingDirectory="$(MSBuildProjectDirectory)\..\..">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitShortHash" />
    </Exec>
    <PropertyGroup>
      <SourceRevisionId Condition="'$(GitShortHash)' != ''">$(GitShortHash)</SourceRevisionId>
      <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">unknown</SourceRevisionId>
      <InformationalVersion>$(Version)+$(SourceRevisionId)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <Resource Include="Assets\ollama_gui_manager_icon.ico" />
    <Resource Include="Assets\startup_splash_logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OllamaToolkit.Core\OllamaToolkit.Core.csproj" />
    <ProjectReference Include="..\OllamaToolkit.BenchmarkStore\OllamaToolkit.BenchmarkStore.csproj" />
    <ProjectReference Include="..\OllamaToolkit.BenchmarkRunner\OllamaToolkit.BenchmarkRunner.csproj" />
    <ProjectReference Include="..\OllamaToolkit.AiAssist\OllamaToolkit.AiAssist.csproj" />
    <ProjectReference Include="..\OllamaToolkit.ModelRegistry\OllamaToolkit.ModelRegistry.csproj" />
    <ProjectReference Include="..\OllamaToolkit.ModelCatalog\OllamaToolkit.ModelCatalog.csproj" />
    <ProjectReference Include="..\OllamaToolkit.ModelCategory\OllamaToolkit.ModelCategory.csproj" />
  </ItemGroup>

</Project>