<Window x:Class="OllamaToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ollama AMD Vulkan Manager"
        Height="820" Width="1180"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource Brush.Bg}">
    <Grid Background="{StaticResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="AlertBar" Grid.Row="0" Background="{StaticResource Brush.WarningBg}"
                BorderBrush="{StaticResource Brush.Warning}" BorderThickness="0,0,0,1"
                Padding="12,8" Visibility="Collapsed">
            <TextBlock x:Name="AlertText" Foreground="{StaticResource Brush.Warning}" TextWrapping="Wrap" />
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="8" SelectionChanged="MainTabs_SelectionChanged"
                    Background="{StaticResource Brush.Bg}">
            <TabItem Header="Compute Modes">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="VulkanLabel" Grid.Row="0" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,8" />
                    <TextBlock x:Name="ModeStatusLabel" Grid.Row="1" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <UniformGrid Grid.Row="2" Columns="3" Rows="2" Margin="0,0,0,8">
                        <Button x:Name="CpuCard" Style="{StaticResource ModeCardButton}" Click="ModeCard_Click" Tag="CPU" />
                        <Button x:Name="ApuCard" Style="{StaticResource ModeCardButton}" Click="ModeCard_Click" Tag="APU" />
                        <Button x:Name="GpuCard" Style="{StaticResource ModeCardButton}" Click="ModeCard_Click" Tag="GPU" />
                        <Button x:Name="HybridCard" Style="{StaticResource ModeCardButton}" Click="ModeCard_Click" Tag="Hybrid" />
                        <Button x:Name="RocmCard" Style="{StaticResource ModeCardButton}" Click="ModeCard_Click" Tag="ROCm" />
                    </UniformGrid>
                    <TextBlock Grid.Row="3" Text="Configuration summary" Foreground="{StaticResource Brush.Muted}"
                               FontSize="14" Margin="0,4,0,4" />
                    <TextBox x:Name="EnvBox" Grid.Row="4" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Background="{StaticResource Brush.LogBg}"
                             Foreground="{StaticResource Brush.Text}" BorderBrush="{StaticResource Brush.PanelBorder}"
                             FontFamily="Segoe UI" FontSize="14" Padding="10" />
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="RestartCheck" Content="Restart Ollama after applying mode" IsChecked="True" Foreground="{StaticResource Brush.Text}" />
                        <Button Content="Refresh" Style="{StaticResource ToolkitButton}" Click="RefreshModes_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="ModelsLaunchTab" Header="Models &amp; Launch">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Launch (Best Mode)" Style="{StaticResource ToolkitButton}" Click="LaunchBestMode_Click" />
                        <Button x:Name="AskAiModelsBtn" Content="Ask AI" Style="{StaticResource ToolkitButton}" Click="AskAiModels_Click" />
                        <Button x:Name="CompareModelsBtn" Content="Compare with AI" Style="{StaticResource ToolkitButton}"
                                Click="CompareModels_Click" ToolTip="Select at least 2 LLM models to compare" />
                        <Button Content="Refresh" Style="{StaticResource ToolkitButton}" Click="RefreshModels_Click" />
                        <Button Content="Import Reports" Style="{StaticResource ToolkitButton}" Click="ImportReports_Click" />
                    </StackPanel>
                    <DataGrid x:Name="ModelsGrid" Grid.Row="1" Style="{StaticResource ToolkitDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" />
                            <DataGridTextColumn Header="File Size" Binding="{Binding FileSize}" Width="80" />
                            <DataGridTextColumn Header="Best Mode" Binding="{Binding BestMode}" Width="80" />
                            <DataGridTextColumn Header="Metric" Binding="{Binding BestMetricDisplay}" Width="70" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Last Tested" Binding="{Binding LastTested}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem x:Name="ModelLibraryTab" Header="Model Library">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <TextBox x:Name="CatalogSearchBox" Padding="6,4" KeyUp="CatalogSearchBox_KeyUp" />
                            <TextBlock Text="Search" IsHitTestVisible="False"
                                       Foreground="{StaticResource Brush.Muted}"
                                       Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=CatalogSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Category:" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Text}" Margin="8,0,4,0" />
                        <ComboBox x:Name="CategoryFilterCombo" Grid.Row="0" Grid.Column="2"
                                  SelectionChanged="CategoryFilterCombo_SelectionChanged" />
                        <Button x:Name="AiDescriptionsModeBtn" Grid.Row="0" Grid.Column="4" Content="AI Descriptions"
                                Style="{StaticResource ToolkitButton}" Margin="0,0,4,0" Click="AiDescriptionsMode_Click" />
                        <Button x:Name="DownloadDescriptionsModeBtn" Grid.Row="0" Grid.Column="5" Content="Official Descriptions"
                                Style="{StaticResource CatalogDescriptionModeActive}" Margin="0,0,4,0"
                                Click="DownloadDescriptionsMode_Click" />
                        <Button x:Name="CatalogCategorizeAllBtn" Grid.Row="0" Grid.Column="7" Content="Categorize All"
                                Style="{StaticResource ToolkitButton}" Margin="0,0,4,0" Click="CategorizeAll_Click" />
                        <Button x:Name="RefreshDescriptionsBtn" Grid.Row="0" Grid.Column="8" Content="Refresh Descriptions"
                                Style="{StaticResource ToolkitButton}" Margin="0,0,4,0" Click="RefreshDescriptions_Click" />
                        <Button x:Name="RefreshCatalogBtn" Grid.Row="0" Grid.Column="9" Content="Refresh Catalog"
                                Style="{StaticResource ToolkitButton}" Margin="0,0,4,0" Click="RefreshCatalog_Click" />
                        <Button x:Name="ClearCatalogBtn" Grid.Row="0" Grid.Column="10" Content="Clear Catalog"
                                Style="{StaticResource ToolkitButton}" Click="ClearCatalog_Click" />
                        <Button x:Name="CatalogStopBtn" Grid.Row="1" Grid.Column="7" Grid.ColumnSpan="4"
                                Content="STOP" Style="{StaticResource ToolkitButton}"
                                Margin="0,4,0,0" Click="CatalogStop_Click" />
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="12"
                                    Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="DownloadCatalogModelBtn" Content="Download Selected LLM"
                                    Style="{StaticResource ToolkitButton}" Margin="0,0,4,0"
                                    Click="DownloadCatalogModel_Click" />
                            <Button x:Name="UninstallCatalogModelBtn" Content="Uninstall Selected LLM"
                                    Style="{StaticResource ToolkitButton}" Margin="0,0,4,0"
                                    Click="UninstallCatalogModel_Click" />
                            <Button x:Name="CompareCatalogBtn" Content="Compare with AI"
                                    Style="{StaticResource ToolkitButton}" Margin="0,0,4,0"
                                    Click="CompareCatalog_Click"
                                    ToolTip="Select at least 2 LLM models to compare" />
                            <Button x:Name="ClearCatalogSelectionsBtn" Content="Clear Selections"
                                    Style="{StaticResource ToolkitButton}" Click="ClearCatalogSelections_Click" />
                            <TextBlock Text="Hold CTRL to select more than one LLM"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Muted}"
                                       Margin="12,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock x:Name="CatalogStatusLabel" Foreground="{StaticResource Brush.Muted}" />
                        <Grid x:Name="CatalogDownloadProgressPanel" Margin="0,6,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="CatalogDownloadProgress" Height="14" Minimum="0" Maximum="100"
                                         Foreground="{StaticResource Brush.Warning}" />
                            <TextBlock x:Name="CatalogDownloadProgressLabel" Grid.Column="1"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text}" />
                        </Grid>
                    </StackPanel>
                    <DataGrid x:Name="CatalogGrid" Grid.Row="2" Style="{StaticResource ToolkitDataGrid}"
                              RowStyle="{StaticResource CatalogInstalledRow}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                              PreviewMouseLeftButtonDown="CatalogGrid_PreviewMouseLeftButtonDown">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Model" Binding="{Binding Name}" Width="120" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110" />
                            <DataGridTextColumn Header="Description" Binding="{Binding DisplayDescription}" Width="*"
                                                MinWidth="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridWrapCell}" />
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Params" Binding="{Binding ParameterSize}" Width="70" />
                            <DataGridTextColumn Header="File Size" Binding="{Binding FileSize}" Width="85" />
                            <DataGridTextColumn Header="Fastest Mode" Binding="{Binding BestMode}" Width="90" />
                            <DataGridTextColumn Header="Best Metric" Binding="{Binding BestTps}" Width="85" />
                            <DataGridTextColumn Header="Installed" Binding="{Binding InstalledDisplay}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem x:Name="ModelRunTab" Header="Model Run">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ModelRunStatus" Grid.Row="0" Margin="0,0,0,8" Foreground="{StaticResource Brush.Muted}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{StaticResource Brush.Bg}">
                        <TextBlock x:Name="ChatHistory" Margin="12" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="ChatInput" Width="520" Padding="8,6" KeyDown="ChatInput_KeyDown" />
                        <Button Content="Send" Style="{StaticResource ToolkitButton}" Margin="8,0,0,0" Click="SendChat_Click" />
                        <Button x:Name="StopChatBtn" Content="Stop" Style="{StaticResource ToolkitButton}" Click="StopChat_Click" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="AskAiRunBtn" Content="Ask AI" Style="{StaticResource ToolkitButton}" Click="AskAiRun_Click" />
                        <Button Content="Open in PowerShell" Style="{StaticResource ToolkitButton}" Click="OpenPowerShell_Click" />
                        <Button Content="Clear Chat" Style="{StaticResource ToolkitButton}" Click="ClearChat_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Testing Suite">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="TestModelCombo" Width="280" Margin="0,0,8,8" SelectionChanged="TestModelCombo_SelectionChanged" />
                        <TextBlock Text="Context Window Size:" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text}" Margin="0,0,4,8" />
                        <TextBox x:Name="TestNumCtxBox" Width="64" Margin="0,0,8,8" Text="8192" />
                        <TextBlock Text="Max Output Frames:" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text}" Margin="0,0,4,8" />
                        <TextBox x:Name="TestNumPredictBox" Width="48" Margin="0,0,8,8" Text="32" />
                        <Button Content="Test Selected" Style="{StaticResource ToolkitButton}" Click="TestSelected_Click" />
                        <Button Content="Test Local Untested" Style="{StaticResource ToolkitButton}" Click="TestUntested_Click" />
                        <Button x:Name="TestUndownloadBtn" Content="Test Undownload" Style="{StaticResource ToolkitButton}" Click="TestUndownload_Click" />
                        <Button x:Name="StopTestBtn" Content="Stop Test" Style="{StaticResource ToolkitButton}" Click="StopTest_Click" />
                        <Button Content="Clear All Test Results" Style="{StaticResource ToolkitButton}" Click="ClearAllTestResults_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TestSettingsLabel" Grid.Row="1" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <StackPanel x:Name="TestProgressPanel" Grid.Row="2" Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBlock x:Name="TestOverallLabel" Foreground="{StaticResource Brush.Text}" Margin="0,0,0,4" TextWrapping="Wrap" />
                        <ProgressBar x:Name="TestOverallProgress" Style="{StaticResource ToolkitProgressBar}"
                                     Height="10" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,8" />
                        <StackPanel x:Name="TestModeProgressPanel" />
                    </StackPanel>
                    <TextBlock x:Name="TestStatusLabel" Grid.Row="3" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <ScrollViewer x:Name="TestLogScroll" Grid.Row="4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="{StaticResource Brush.LogBg}">
                        <TextBox x:Name="TestLogBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalScrollBarVisibility="Disabled"
                                 Foreground="{StaticResource Brush.Text}" FontFamily="Consolas" FontSize="14" />
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="TestResultsTab" Header="Test Results">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Refresh" Style="{StaticResource ToolkitButton}" Click="RefreshTestResults_Click" />
                        <Button Content="Launch Selected" Style="{StaticResource ToolkitButton}" Click="LaunchFromResults_Click" />
                        <Button Content="Clear All Test Results" Style="{StaticResource ToolkitButton}" Click="ClearAllTestResults_Click" />
                    </StackPanel>
                    <DataGrid x:Name="TestResultsGrid" Grid.Row="1" Style="{StaticResource ToolkitDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              EnableRowVirtualization="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Visible"
                              ScrollViewer.CanContentScroll="False"
                              SelectionChanged="TestResultsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="160" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" />
                            <DataGridTextColumn Header="Best" Binding="{Binding BestMode}" Width="72" />
                            <DataGridTextColumn Header="Metric" Binding="{Binding BestMetricDisplay}" Width="80" />
                            <DataGridTextColumn Header="CPU" Binding="{Binding CpuResult}" Width="55"
                                                CellStyle="{StaticResource TestResultWinnerCellCpu}" />
                            <DataGridTextColumn Header="APU" Binding="{Binding ApuResult}" Width="55"
                                                CellStyle="{StaticResource TestResultWinnerCellApu}" />
                            <DataGridTextColumn Header="GPU" Binding="{Binding GpuResult}" Width="55"
                                                CellStyle="{StaticResource TestResultWinnerCellGpu}" />
                            <DataGridTextColumn Header="Hybrid" Binding="{Binding HybridResult}" Width="55"
                                                CellStyle="{StaticResource TestResultWinnerCellHybrid}" />
                            <DataGridTextColumn Header="ROCm" Binding="{Binding RocmResult}" Width="55"
                                                CellStyle="{StaticResource TestResultWinnerCellRocm}" />
                            <DataGridTextColumn Header="Insight" Binding="{Binding Insight}" Width="*"
                                                MinWidth="280">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}" />
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tested" Binding="{Binding LastTested}" Width="140" />
                            <DataGridTemplateColumn Header="Clear" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Clear" Style="{StaticResource ToolkitButton}"
                                                Padding="6,2" Margin="0" FontSize="12"
                                                Click="ClearTestResultRow_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="TestResultDetail" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Muted}" />
                </Grid>
            </TabItem>
            <TabItem x:Name="AiSettingsTab" Header="AI Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <TextBlock x:Name="AiSettingsStatus" Foreground="{StaticResource Brush.Text}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Summarizer model:" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text}" />
                            <ComboBox x:Name="SummarizerCombo" Width="240" Margin="8,0,0,0" SelectionChanged="SummarizerCombo_SelectionChanged" />
                            <Button x:Name="RefreshSummarizerListBtn" Content="Refresh List" Style="{StaticResource ToolkitButton}" Click="RefreshSummarizerList_Click" />
                            <Button x:Name="DownloadSummarizerBtn" Content="Download Selected" Style="{StaticResource ToolkitButton}" Click="DownloadSummarizer_Click" />
                            <Button x:Name="TestSummarizerBtn" Content="Test Summarizer" Style="{StaticResource ToolkitButton}" Click="TestSummarizer_Click" />
                        </StackPanel>
                        <TextBlock x:Name="AiSettingsActionStatus" TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}" Margin="0,0,0,8" />
                        <TextBlock x:Name="SummarizerTestResult" TextWrapping="Wrap" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,16" />
                        <TextBlock Text="Suggested models (not installed):" Foreground="{StaticResource Brush.Text}" Margin="0,0,0,4" />
                        <ListBox x:Name="SuggestedModelsList" Height="120" Margin="0,0,0,16" />
                        <TextBlock x:Name="CategoryStatusLabel" Foreground="{StaticResource Brush.Text}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CategorizeAllBtn" Content="Categorize All" Style="{StaticResource ToolkitButton}" Click="CategorizeAll_Click" />
                            <Button x:Name="RecategorizeAllBtn" Content="Recategorize All" Style="{StaticResource ToolkitButton}" Click="RecategorizeAll_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="AI Features">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel x:Name="AiFeaturesPanel" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="AI Activity">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Scan Logs" Style="{StaticResource ToolkitButton}" Click="ScanLogs_Click" />
                        <TextBlock x:Name="AnomalySummary" Foreground="{StaticResource Brush.Warning}" Margin="12,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox x:Name="AiActivityLog" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Background="{StaticResource Brush.LogBg}"
                             Foreground="{StaticResource Brush.Text}" />
                </Grid>
            </TabItem>
        </TabControl>

        <Popup x:Name="AiFlyoutPopup" Placement="Center" AllowsTransparency="True" StaysOpen="False">
            <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}"
                    BorderThickness="1" Padding="16" MaxWidth="520">
                <StackPanel>
                    <TextBlock x:Name="AiFlyoutTitle" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" Margin="0,0,0,8" />
                    <TextBlock x:Name="AiFlyoutBody" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" Margin="0,0,0,12" />
                    <Button Content="Close" Style="{StaticResource ToolkitButton}" HorizontalAlignment="Right" Click="CloseAiFlyout_Click" />
                </StackPanel>
            </Border>
        </Popup>

        <Border Grid.Row="2" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.Muted}" FontSize="14"
                           Text="Model lists load from Ollama API and cached profiles. Start Ollama if lists are empty." />
                <Button x:Name="AiStatusButton" HorizontalAlignment="Right" Style="{StaticResource ToolkitButton}"
                        Content="AI Inactive" Click="AiStatusButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>